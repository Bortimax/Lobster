__pycache__/
*.pyc
cells/
*.lobster_cell

# Native accelerator: the source is committed, the binary is not (D42).
# Every platform builds and differentially tests its own.
*.pyd
*.so
*.dylib
*.o
*.obj
# Anchored to the repository root: `lobster/build/` is a *package*, and an
# unanchored `build/` silently ignored every new file in it. Two modules were
# written into it before `git status` was read carefully enough to notice.
/build/
*.egg-info/
